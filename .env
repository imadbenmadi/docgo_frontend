# healthpathglobal frontend (Vite)
#
# Production values. `npm run dev` loads .env.development on top of this, so
# a local run does not need to touch these.
#
# Until this file existed, VITE_API_URL was undefined in every component that
# read it directly, which rendered image sources as
# "undefined/Courses_Pictures/x.png".
VITE_API_URL=https://backend.healthpathglobal.com
VITE_SITE_URL=https://healthpathglobal.com
VITE_SITE_NAME=HealthPathGlobal
